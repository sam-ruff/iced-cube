{
  "name": "iced-cube-site",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-data": "node scripts/prepare.mjs",
    "coverage": "node scripts/check-coverage.mjs",
    "dev": "astro dev",
    "dev:mock": "PUBLIC_PREVIEW_MODE=mock astro dev",
    "check": "astro check && node scripts/check-coverage.mjs",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "test:unit": "node --test --experimental-strip-types tests/unit/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.5",
    "lucide-static": "^1.48.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "binaryen": "^132.0.0",
    "pagefind": "^1.5.2",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3"
  }
}
