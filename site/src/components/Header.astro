---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { href } from "../lib/paths";

const path = Astro.url.pathname;
const inDocs = path.startsWith(href("/docs/"));
const inComponents = path.startsWith(href("/docs/components/"));
---

<header class="header">
  <div class="inner">
    <button class="icon-btn menu" type="button" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false" data-menu-toggle>
      <Icon name="Menu" size={18} />
    </button>
    <a class="brand" href={href("/")}>
      <Logo size={22} />
      <span>iced-cube</span>
    </a>
    <nav class="links" aria-label="Primary">
      <a href={href("/docs/")} aria-current={inDocs && !inComponents ? "page" : undefined}>Docs</a>
      <a href={href("/docs/components/")} aria-current={inComponents ? "page" : undefined}>Components</a>
    </nav>
    <div class="actions">
      <button class="search-trigger" type="button" data-search-open aria-label="Search documentation">
        <Icon name="Search" size={15} />
        <span class="label">Search docs...</span>
        <kbd class="shortcut" data-shortcut>Ctrl K</kbd>
      </button>
      <a class="icon-btn" href="https://github.com/sam-ruff/iced-cube" aria-label="Source code on GitHub">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
      </a>
      <a class="icon-btn" href="https://crates.io/crates/iced-cube" aria-label="iced-cube on crates.io">
        <Icon name="Package" size={18} />
      </a>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch to dark theme">
        <span class="sun"><Icon name="Sun" size={18} /></span>
        <span class="moon"><Icon name="Moon" size={18} /></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .inner {
    height: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 650;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .links {
    display: flex;
    gap: 4px;
    margin-left: 8px;
  }

  .links a {
    font-size: 14px;
    color: var(--fg-muted);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    transition: color 150ms var(--ease), background 150ms var(--ease);
  }

  .links a:hover {
    color: var(--fg);
    background: var(--muted);
  }

  .links a[aria-current="page"] {
    color: var(--fg);
    font-weight: 550;
  }

  .actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .search-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    width: 240px;
    padding: 0 8px 0 12px;
    margin-right: 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-subtle);
    color: var(--fg-subtle);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
    transition: border-color 150ms var(--ease), background 150ms var(--ease);
  }

  .search-trigger:hover {
    border-color: var(--border-strong);
    background: var(--muted);
  }

  .search-trigger .shortcut {
    margin-left: auto;
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
    transition: color 150ms var(--ease), background 150ms var(--ease);
  }

  .icon-btn:hover {
    color: var(--fg);
    background: var(--muted);
  }

  .menu {
    display: none;
    margin-left: -8px;
  }

  :global([data-theme="dark"]) .sun,
  :global([data-theme="light"]) .moon {
    display: none;
  }

  .sun,
  .moon {
    display: inline-grid;
  }

  @media (max-width: 1023px) {
    .menu {
      display: inline-grid;
    }
  }

  @media (max-width: 767px) {
    .links {
      display: none;
    }

    .search-trigger {
      width: 36px;
      padding: 0;
      justify-content: center;
      margin-right: 0;
      border-color: transparent;
      background: transparent;
    }

    .search-trigger .label,
    .search-trigger .shortcut {
      display: none;
    }

    .search-trigger :global(svg) {
      width: 18px;
      height: 18px;
    }
  }

  @media (max-width: 380px) {
    .actions a[href*="crates.io"] {
      display: none;
    }
  }
</style>
